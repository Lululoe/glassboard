PORT=3001
CONFIG_FILE=./config.yaml
SERVICES_FILE=./services.yaml
# The password edit mode asks for, at least 8 characters. Without it, editing stays off even with
# editable: true in config.yaml.
# EDIT_PASSWORD=
# Domains Glassboard is reached at, besides IP addresses and local names (glassboard.local, ...),
# such as the one your reverse proxy serves it at. Others are refused.
# ALLOWED_HOSTS=dash.example.com
